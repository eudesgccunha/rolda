# Copy to .env (cp .env.example .env) and set a real password.
# .env is git-ignored. Never commit it.
CLICKHOUSE_USER=rolda
CLICKHOUSE_PASSWORD=change-me
POSTGRES_USER=rolda
POSTGRES_PASSWORD=change-me

# Only needed with the "app" profile (docker compose --profile app up -d).
# At least 16 characters. Generate one with: openssl rand -hex 24
ROLDA_API_TOKEN=change-me-to-a-long-random-token
# Host port of the API if 8000 is taken (loopback only):
# ROLDA_API_HOST_PORT=8001
# Optional alert channels for the worker:
# ROLDA_WEBHOOK_URL=
# ROLDA_SLACK_WEBHOOK_URL=
# ROLDA_GOOGLE_CHAT_WEBHOOK_URL=
# ROLDA_TEAMS_WEBHOOK_URL=
